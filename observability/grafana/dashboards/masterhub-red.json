{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{service_name=\"masterhub-api\"}[5m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "5xx error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_total{service_name=\"masterhub-api\",http_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{service_name=\"masterhub-api\"}[5m])), 0.001)",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_seconds_bucket{service_name=\"masterhub-api\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "JSON application logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{job=\"masterhub\",service_name=\"masterhub-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "alertlist",
      "title": "Alerts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "showInstances": false,
        "alertName": "",
        "alertInstanceLabelFilter": "{service=\"masterhub-api\"}",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": true,
          "error": true
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "masterhub",
    "observability",
    "red"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "MasterHub RED",
  "uid": "masterhub-red",
  "version": 2
}